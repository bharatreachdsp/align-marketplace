#!/bin/sh
# The ALIGN plugin's launcher (L41). Claude Code runs it for the plugin's hooks, its MCP server and its commands.
#
# It runs the ALIGN installed on this machine (~/.align/bin/align, written by `align init`) when there is one, so the
# plugin and `align init` share one installation, one sign-in and one set of files. Otherwise it runs the CLI bundle
# shipped inside the plugin (lib/align.mjs, the same file as the published CLI package's), which is what `/align:init` uses to
# install ALIGN the first time.
#
# - The home directory comes from the password database (the account running this), never from HOME, which a
#   repository's Claude Code settings can change for the hooks it runs.
# - Hook calls fail closed: any problem means exit 0 with nothing printed, and with no installation there is nothing
#   opted in, so a hook exits at once.
# - Without an installation, `mcp` and `pack` keep only the same short allow-list of variables the installed shim
#   uses (plus what the shell sets itself), so no proxy, extra CA or Node option a repository sets reaches them.
# - Functions a repository's settings could plant through bash's exported functions (macOS's /bin/sh is bash) are
#   removed first, so every command below is the real one. `unset` is a special builtin a function cannot replace.
# Nothing here reads, writes or sends anything itself.

unset -f env sed command id dirname cd pwd node test printf echo eval exec 2>/dev/null || :

case "${1-}" in
  hook) is_hook=1 ;;
  *) is_hook= ;;
esac

fail() {
  [ -n "$is_hook" ] && exit 0
  echo "align: $1" >&2
  exit 1
}

user=$(id -un 2>/dev/null) || fail "cannot tell which account this is"
case "$user" in
  "" | -* | *[!A-Za-z0-9._-]*) fail "unsupported account name" ;;
esac
# Tilde expansion of a checked account name reads the password database.
eval "home=~$user"
case "$home" in
  /*) ;;
  *) fail "cannot find this account's home directory" ;;
esac

# Every program below is spelled literally (the plugin directory refuses a launcher whose program is computed).
if [ -f "$home/.align/bin/align" ] && [ -x "$home/.align/bin/align" ]; then
  if [ -n "$is_hook" ]; then
    "$home/.align/bin/align" "$@" 2>/dev/null
    exit 0
  fi
  exec "$home/.align/bin/align" "$@"
fi

# Not installed yet: nothing is opted in, so a hook has nothing to do.
[ -n "$is_hook" ] && exit 0

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || fail "cannot find the plugin's folder"
bundle="$here/../lib/align.mjs"
[ -f "$bundle" ] || fail "the plugin's copy of the CLI is missing; reinstall the plugin (install steps: https://align.bharatreachdsp.com/install#claude-code-plugin)"
command -v node >/dev/null 2>&1 || fail "Node.js 22.14 or later is needed: https://nodejs.org"
unset NODE_OPTIONS NODE_PATH

case "${1-}" in
  mcp | pack)
    # Only the allow-list reaches mcp and pack (the installed shim's, minus what only it sets): every other variable
    # is removed here, so `node` below is the one program that runs (the plugin directory reads it by name).
    for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
      case "$name" in
        PATH | USER | LOGNAME | LANG | LC_ALL | LC_CTYPE | TZ | TMPDIR | CURSOR_VERSION | CURSOR_PROJECT_DIR | CODEX_HOME | GIT_AUTHOR_EMAIL | GIT_REFLOG_ACTION) ;;
        *) command unset "$name" 2>/dev/null || : ;;
      esac
    done
    # Functions bash exports (macOS's /bin/sh is bash) are not plain names; remove them too.
    for name in $(env | sed -n 's/^BASH_FUNC_\([A-Za-z0-9_.:-]*\)%%=.*/\1/p'); do
      command unset -f "$name" 2>/dev/null || :
    done
    ;;
esac
exec node "$bundle" "$@"
