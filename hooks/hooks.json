{
  "description": "ALIGN's session hooks. They do nothing until you run /align:init in a repository and opt it in.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/align\" hook session-start --harness claude-code --via plugin",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/align\" hook prompt --harness claude-code --via plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/align\" hook stop --harness claude-code --via plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/align\" hook session-end --harness claude-code --via plugin",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
